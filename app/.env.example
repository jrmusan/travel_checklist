# Postgres (Vercel Postgres / Neon). Required for auth and shared team state.
POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Signs session cookies (JWT). Use a long random string; never commit the real value.
SESSION_SECRET="generate-a-long-random-secret-at-least-32-chars"

# Optional: enables GET /api/setup/migrate?secret=… for one-time schema apply in production.
# SETUP_SECRET="long-random-secret-at-least-16-chars"
